#!/usr/bin/python3
"""
Apply what the CybICS-mgmt server asks of this Raspberry Pi, and report.

The server runs as a non-root user in a read-only container. It writes
requests into /run/cybics-mgmt (a tmpfs, so a password never reaches the SD
card), which it sees as MGMT_HOST_DIR. cybics-mgmt-host.path starts this
script when a request appears; it also runs once at boot.

Two requests exist, nothing else:

- pi-password.json: a new password for the "pi" account, applied with
  chpasswd. Once pi has a password of its own, SSH is switched on (the image
  ships with it off, because the access point's Wi-Fi password is public).
- settings.json: values for cybics-mgmt.txt on the boot partition, checked
  with cybics-mgmt-config's own rules (only its keys, only valid values),
  written into that file and applied: cybics-mgmt-config runs again, the
  HDMI kiosk restarts, the containers restart for a new server name or
  enrolment code, and the access point restarts for new Wi-Fi settings.

Each request is moved out of the server's reach before anything else
happens. The answers, whether pi still has the default password
"raspberry", and the settings now in cybics-mgmt.txt go to status.json for
the admin UI.

The request directory belongs to the container's user, so a compromised
server controls every name in it: nothing there is followed as a symlink,
opened unless it is a regular file, or trusted as earlier output. What this
script keeps for itself lives in PRIVATE, which only root can enter.
"""
import hmac
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import stat
import subprocess
import tempfile
import time

DIRECTORY = "/run/cybics-mgmt"
REQUEST = os.path.join(DIRECTORY, "pi-password.json")
SETTINGS_REQUEST = os.path.join(DIRECTORY, "settings.json")
STATUS = os.path.join(DIRECTORY, "status.json")
PRIVATE = "/run/cybics-mgmt-host"
LAST = os.path.join(PRIVATE, "last.json")
LAST_SETTINGS = os.path.join(PRIVATE, "last-settings.json")
TAKEN = os.path.join(PRIVATE, "request.json")
USER = "pi"
CONFIG = "/usr/local/sbin/cybics-mgmt-config"
AP_CONNECTION = "cybics-mgmt-ap"
WIFI_KEYS = {"WIFI_SSID", "WIFI_PASSWORD", "WIFI_COUNTRY"}
SERVER_KEYS = {"SERVER_NAME", "DEFAULT_ENROL_CODE"}
HDMI_KEYS = {"HDMI_SCOREBOARD", "HDMI_THEME"}


def default_password():
    """True while pi's password is still "raspberry" (checked with the system's crypt())."""
    try:
        with open("/etc/shadow", encoding="utf-8") as f:
            entry = next((line.split(":") for line in f if line.startswith(USER + ":")), None)
    except OSError:
        return None
    if not entry or len(entry) < 2 or not entry[1] or entry[1][0] in "!*":
        return False
    stored = entry[1]
    result = subprocess.run(["perl", "-e", "print crypt($ARGV[0], $ARGV[1])", "raspberry", stored],
                            capture_output=True, text=True, timeout=10)
    return hmac.compare_digest(result.stdout, stored)


def remove(path):
    """Delete whatever is at `path`; a directory goes with its content, symlinks in it unfollowed."""
    try:
        os.unlink(path)
    except IsADirectoryError:
        shutil.rmtree(path, ignore_errors=True)
    except FileNotFoundError:
        pass


def load_config():
    """cybics-mgmt-config as a module: its CHECKS, read_settings() and write_settings() are the rules."""
    loader = importlib.machinery.SourceFileLoader("cybics_mgmt_config", CONFIG)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def take_request(request):
    """
    The waiting request's content, or None. It is renamed into PRIVATE first
    (a rename moves a symlink itself, never its target), so a request written
    while this one is applied waits for the next run instead of being deleted
    unread.
    """
    try:
        os.rename(request, TAKEN)
    except FileNotFoundError:
        return None
    try:
        fd = os.open(TAKEN, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        raise ValueError("the request is not a regular file") from None
    finally:
        remove(TAKEN)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise ValueError("the request is not a regular file")
    with os.fdopen(fd, "rb") as f:
        return f.read(4096).decode("utf-8")


def apply_request():
    """Apply a waiting password request. Returns the result for status.json, or None if there was none."""
    raw = take_request(REQUEST)
    if raw is None:
        return None
    data = json.loads(raw)
    password = data.get("password") if isinstance(data, dict) else None
    if not isinstance(data, dict) or data.get("user") != USER:
        raise ValueError("only the pi account can be changed")
    if not isinstance(password, str) or not 8 <= len(password) <= 128 or re.search(r"[\x00-\x1f\x7f]", password):
        raise ValueError("the password needs 8 to 128 characters without control characters")
    subprocess.run(["chpasswd"], input=f"{USER}:{password}\n", text=True, check=True, capture_output=True,
                   timeout=30)
    return {"state": "done", "detail": "", "time": time.time()}


def apply_settings(config):
    """
    Apply a waiting settings request. Returns (result for status.json, what
    to restart afterwards), or (None, []) if there was none.
    """
    raw = take_request(SETTINGS_REQUEST)
    if raw is None:
        return None, []
    data = json.loads(raw)
    wanted = data.get("settings") if isinstance(data, dict) else None
    if not isinstance(wanted, dict) or not wanted:
        raise ValueError("no settings in the request")
    values = {}
    for key, value in wanted.items():
        if key not in config.CHECKS or not isinstance(value, str):
            raise ValueError(f"unknown setting {key!r}")
        value = config.normalise(key, value)
        check, rule = config.CHECKS[key]
        if not check(value):
            raise ValueError(f"{key} must be {rule}")
        values[key] = value
    config.write_settings(config.BOOT_FILE, values)
    subprocess.run([CONFIG], check=True, capture_output=True, text=True, timeout=120)
    after = []
    if HDMI_KEYS & values.keys():
        after.append(["systemctl", "restart" if os.path.exists(config.KIOSK_FILE) else "stop",
                      "cybics-mgmt-kiosk.service"])
    if SERVER_KEYS & values.keys():
        # The server that sent this request restarts; --no-block, it answered already.
        after.append(["systemctl", "restart", "--no-block", "cybics-mgmt.service"])
    if WIFI_KEYS & values.keys():
        after.append(["nmcli", "connection", "reload"])
        after.append(["nmcli", "connection", "up", AP_CONNECTION])
    after.append(["/usr/local/sbin/cybics-mgmt-issue"])   # the console's connection details
    detail = "changed " + ", ".join(sorted(values))
    return {"state": "done", "detail": detail[:200], "time": time.time()}, after


def failed(exc):
    detail = exc.stderr.strip() if isinstance(exc, subprocess.CalledProcessError) and exc.stderr else str(exc)
    return {"state": "failed", "detail": detail[:200], "time": time.time()}


def remembered(path, result):
    """Keep a new result in PRIVATE, or return the one kept from an earlier run."""
    if result is not None:
        write_json(PRIVATE, path, result)
        return result
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(directory, path, data):
    """Write `data` to `path` atomically, through a new file that cannot be a symlink planted beforehand."""
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".status.")   # O_CREAT | O_EXCL, mode 0600
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f)
            os.fchmod(f.fileno(), 0o644)
        os.replace(tmp, path)   # replaces whatever is at `path`, a symlink included, without following it
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def enable_ssh():
    """SSH comes on once pi has a password of its own (it stays on after that)."""
    try:
        subprocess.run(["systemctl", "enable", "--now", "ssh"], check=True, capture_output=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        pass   # reported nowhere: the next run tries again


def main():
    os.makedirs(PRIVATE, mode=0o700, exist_ok=True)
    remove(TAKEN)   # left over if a run was cut short
    config = load_config()
    try:
        last = apply_request()
    except Exception as exc:   # any problem is reported, never left unanswered
        last = failed(exc)
    after = []
    try:
        settings_last, after = apply_settings(config)
    except Exception as exc:
        settings_last = failed(exc)
    last = remembered(LAST, last)
    settings_last = remembered(LAST_SETTINGS, settings_last)
    default = default_password()
    if default is False:
        enable_ssh()
    problems = []
    settings = config.read_settings(config.BOOT_FILE, problems)
    status = {"pi_default_password": default, "last": last, "settings_last": settings_last,
              "settings": settings, "problems": problems}
    write_json(PRIVATE, os.path.join(PRIVATE, "status.json"), status)   # for cybics-mgmt-issue
    write_json(DIRECTORY, STATUS, status)
    # Last: these may take the server, or the admin's Wi-Fi, away for a moment.
    for command in after:
        try:
            subprocess.run(command, capture_output=True, timeout=120)
        except (OSError, subprocess.SubprocessError):
            pass   # the settings are in cybics-mgmt.txt; the next boot applies them anyway


if __name__ == "__main__":
    main()
