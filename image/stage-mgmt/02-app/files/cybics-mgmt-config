#!/usr/bin/python3
"""
Apply /boot/firmware/cybics-mgmt.txt at boot (cybics-mgmt-config.service).

Runs before NetworkManager and the CybICS-mgmt containers start. Writes the
access point's SSID and password into its NetworkManager profile, sets the
Wi-Fi country, writes the server's settings into /opt/cybics-mgmt/.env, and
decides whether the HDMI output shows the scoreboard (cybics-mgmt-kiosk).
No password goes there: the admin password is set in the browser.
Anything not valid is reported and replaced by its default.
"""
import os
import re
import subprocess
import sys

BOOT_FILE = "/boot/firmware/cybics-mgmt.txt"
AP_PROFILE = "/etc/NetworkManager/system-connections/cybics-mgmt-ap.nmconnection"
ENV_FILE = "/opt/cybics-mgmt/.env"
# Present (holding the theme) when cybics-mgmt-kiosk.service is to run.
KIOSK_FILE = "/run/cybics-mgmt-kiosk"
# Chromium next to the two containers needs more than a Pi Zero 2 W's 512 MB;
# a 1 GB Pi reports somewhat less than 1 GB after the GPU and kernel share.
KIOSK_AUTO_MIN_KB = 768 * 1024
# Root's own tmpfs directory (see cybics-mgmt-host), not the one the server can write to.
PROBLEMS_FILE = "/run/cybics-mgmt-host/config-problems"

CHECKS = {
    # NetworkManager keyfiles treat a backslash as an escape, so none is allowed.
    "WIFI_SSID": (lambda v: 1 <= len(v.encode()) <= 32 and v.isprintable() and "\\" not in v,
                  "1 to 32 characters without a backslash"),
    "WIFI_PASSWORD": (lambda v: re.fullmatch(r"[\x20-\x5b\x5d-\x7e]{8,63}", v),
                      "8 to 63 printable ASCII characters without a backslash"),
    "WIFI_COUNTRY": (lambda v: re.fullmatch(r"[A-Z]{2}", v), "a two-letter country code"),
    "DEFAULT_ENROL_CODE": (lambda v: v == "" or re.fullmatch(r"[A-Z0-9][A-Z0-9-]{3,15}", v),
                           "empty, or 4 to 16 letters, digits or dashes"),
    "SERVER_NAME": (lambda v: 1 <= len(v) <= 64 and "'" not in v and v.isprintable(),
                    "1 to 64 characters without a ' quote"),
    "HDMI_SCOREBOARD": (lambda v: v in ("auto", "on", "off"), "auto, on or off"),
    "HDMI_THEME": (lambda v: v in ("dark", "light"), "dark or light"),
}
DEFAULTS = {"WIFI_SSID": "cybics-mgmt", "WIFI_PASSWORD": "cybics-mgmt", "WIFI_COUNTRY": "US",
            "DEFAULT_ENROL_CODE": "CYBICS-BOARDS", "SERVER_NAME": "CybICS-mgmt",
            "HDMI_SCOREBOARD": "auto", "HDMI_THEME": "dark"}


def read_settings(path, problems):
    settings = dict(DEFAULTS)
    try:
        with open(path, encoding="utf-8-sig", errors="replace") as f:
            lines = f.read().splitlines()
    except OSError as exc:
        problems.append(f"cannot read {path}: {exc}; using the defaults")
        return settings
    for number, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, value = line.partition("=")
        key, value = key.strip().upper(), value.strip()
        if key == "ADMIN_PASSWORD":
            problems.append(f"line {number}: ADMIN_PASSWORD is not used; the first visit to /admin sets it")
            continue
        if not sep or key not in CHECKS:
            problems.append(f"line {number}: unknown setting {key!r}")
            continue
        value = normalise(key, value)
        check, rule = CHECKS[key]
        if check(value):
            settings[key] = value
        else:
            problems.append(f"line {number}: {key} must be {rule}; keeping {DEFAULTS[key]!r}")
    return settings


def normalise(key, value):
    """A value as it is read from the file: codes in upper case, the HDMI words in lower case."""
    value = value.strip()
    if key in ("WIFI_COUNTRY", "DEFAULT_ENROL_CODE"):
        return value.upper()
    if key in ("HDMI_SCOREBOARD", "HDMI_THEME"):
        return value.lower()
    return value


def write_settings(path, values):
    """
    Set KEY=value lines in cybics-mgmt.txt (the admin UI, through
    cybics-mgmt-host), keeping its comments and order; keys it lacks are
    appended. The values must have passed CHECKS. Written atomically.
    """
    try:
        with open(path, encoding="utf-8-sig") as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = []
    done = set()
    for number, line in enumerate(lines):
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        key = stripped.partition("=")[0].strip().upper()
        if key in values:
            lines[number] = f"{key}={values[key]}" if key not in done else f"# {line}"
            done.add(key)
    lines += [f"{key}={value}" for key, value in values.items() if key not in done]
    tmp = path + ".new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def replace_lines(path, values):
    """Set key=value lines in a NetworkManager keyfile, keeping its comments. True if it changed."""
    with open(path, encoding="utf-8") as f:
        old = f.read()
    new = old
    for key, value in values.items():
        new = re.sub(rf"(?m)^{key}=.*$", lambda _m, k=key, v=value: f"{k}={v}", new)
    if new != old:
        with open(path, "w", encoding="utf-8") as f:
            f.write(new)
        os.chmod(path, 0o600)
    return new != old


def set_country(country, problems):
    try:
        current = subprocess.run(["raspi-config", "nonint", "get_wifi_country"], capture_output=True,
                                 text=True, timeout=30).stdout.strip()
        if current != country:
            subprocess.run(["raspi-config", "nonint", "do_wifi_country", country], check=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as exc:
        problems.append(f"cannot set the Wi-Fi country to {country}: {exc}")


def write_env(settings):
    lines = [
        "# Written by cybics-mgmt-config from /boot/firmware/cybics-mgmt.txt at every boot.",
        "MGMT_PORT=80",
        # The access point's address, for the links `flask ... login-link` prints.
        "MGMT_PUBLIC_URL=http://10.42.0.1",
        f"MGMT_SERVER_NAME='{settings['SERVER_NAME']}'",
        f"MGMT_DEFAULT_ENROL_CODE='{settings['DEFAULT_ENROL_CODE']}'",
    ]
    os.makedirs(os.path.dirname(ENV_FILE), exist_ok=True)
    fd = os.open(ENV_FILE + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(ENV_FILE + ".new", ENV_FILE)


def memory_kb():
    try:
        with open("/proc/meminfo", encoding="utf-8") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return 0


def set_kiosk(settings):
    """The scoreboard on HDMI: on, off, or (auto) on if the Pi has the memory for it."""
    mode = settings["HDMI_SCOREBOARD"]
    if mode == "on" or (mode == "auto" and memory_kb() >= KIOSK_AUTO_MIN_KB):
        with open(KIOSK_FILE, "w", encoding="utf-8") as f:
            f.write(settings["HDMI_THEME"] + "\n")
        os.chmod(KIOSK_FILE, 0o644)
    elif os.path.exists(KIOSK_FILE):
        os.unlink(KIOSK_FILE)


def main():
    problems = []
    settings = read_settings(BOOT_FILE, problems)
    replace_lines(AP_PROFILE, {"ssid": settings["WIFI_SSID"], "psk": settings["WIFI_PASSWORD"]})
    set_country(settings["WIFI_COUNTRY"], problems)
    write_env(settings)
    set_kiosk(settings)
    os.makedirs(os.path.dirname(PROBLEMS_FILE), mode=0o700, exist_ok=True)
    with open(PROBLEMS_FILE, "w", encoding="utf-8") as f:
        f.write("".join(p + "\n" for p in problems))
    for problem in problems:
        print(f"cybics-mgmt.txt: {problem}", file=sys.stderr)


if __name__ == "__main__":
    main()
